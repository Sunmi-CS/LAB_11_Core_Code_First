@model Eventos.Web.Models.Inscripcion

@{
    ViewData["Title"] = "Registrar Inscripción";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> Volver a la lista de inscripciones
            </a>
            <h2 class="fw-bold mb-1">Registrar Nueva Inscripción</h2>
            <p class="text-muted small">Selecciona el evento y el asistente correspondiente para confirmar su participación.</p>
        </div>

        <div class="card border-0 shadow-sm p-4 p-md-5 bg-white">
            <div class="alert alert-light border small d-flex align-items-center gap-2 mb-4 text-muted">
                <i class="bi bi-info-circle-fill text-primary fs-5 flex-shrink-0"></i>
                <div>
                    El sistema valida automáticamente que el evento cuente con cupos disponibles antes de confirmar la inscripción.
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm py-2 px-3 small"></div>

                <div class="mb-3">
                    <label asp-for="EventoId" class="form-label fw-semibold">
                        <i class="bi bi-calendar2-event text-primary me-1"></i>Evento Destino
                    </label>
                    <select asp-for="EventoId"
                            asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(
                                (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.EventoId,
                                "Value",
                                "Text",
                                ViewBag.EventoSeleccionado))"
                            class="form-select">
                        <option value="">Selecciona un evento</option>
                    </select>
                    <span asp-validation-for="EventoId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="AsistenteId" class="form-label fw-semibold">
                        <i class="bi bi-person-check text-primary me-1"></i>Asistente Participante
                    </label>
                    <select asp-for="AsistenteId"
                            asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(
                                (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.AsistenteId,
                                "Value",
                                "Text",
                                ViewBag.AsistenteSeleccionado))"
                            class="form-select">
                        <option value="">Selecciona un asistente</option>
                    </select>
                    <span asp-validation-for="AsistenteId" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2 pt-3 border-top">
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 shadow-sm">
                        <i class="bi bi-check2-circle"></i>
                        <span>Confirmar Inscripción</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-4">
                        <i class="bi bi-x-circle"></i>
                        <span>Cancelar</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
