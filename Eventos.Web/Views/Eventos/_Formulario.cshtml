@model Eventos.Web.Models.Evento

<div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm py-2 px-3 small"></div>

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Titulo" class="form-label fw-semibold">
            <i class="bi bi-type-h1 text-primary me-1"></i>Título del Evento
        </label>
        <input asp-for="Titulo" class="form-control" placeholder="Ej: Conferencia Anual de Innovación Tecnológica" />
        <span asp-validation-for="Titulo" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Fecha" class="form-label fw-semibold">
            <i class="bi bi-calendar-event text-primary me-1"></i>Fecha y Hora
        </label>
        <input asp-for="Fecha" type="datetime-local" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Lugar" class="form-label fw-semibold">
            <i class="bi bi-geo-alt text-primary me-1"></i>Lugar o Plataforma
        </label>
        <input asp-for="Lugar" class="form-control" placeholder="Ej: Auditorio Central / Zoom Meetings" />
        <span asp-validation-for="Lugar" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Aforo" class="form-label fw-semibold">
            <i class="bi bi-people text-primary me-1"></i>Aforo Máximo
        </label>
        <input asp-for="Aforo" type="number" class="form-control" placeholder="Ej: 100" />
        <span asp-validation-for="Aforo" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Precio" class="form-label fw-semibold">
            <i class="bi bi-currency-dollar text-primary me-1"></i>Precio de Entrada (S/)
        </label>
        <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
        <span asp-validation-for="Precio" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Modalidad" class="form-label fw-semibold">
            <i class="bi bi-broadcast text-primary me-1"></i>Modalidad
        </label>
        <select asp-for="Modalidad" class="form-select">
            <option value="">Selecciona una modalidad</option>
            <option value="Presencial">Presencial</option>
            <option value="Virtual">Virtual</option>
        </select>
        <span asp-validation-for="Modalidad" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CategoriaId" class="form-label fw-semibold">
            <i class="bi bi-tag text-primary me-1"></i>Categoría
        </label>
        <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select">
            <option value="">Selecciona una categoría</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
    </div>
</div>
