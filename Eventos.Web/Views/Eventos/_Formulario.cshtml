@model Eventos.Web.Models.Evento

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Titulo" class="form-label"></label>
    <input asp-for="Titulo" class="form-control" />
    <span asp-validation-for="Titulo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Fecha" class="form-label"></label>
    <input asp-for="Fecha" type="datetime-local" class="form-control" />
    <span asp-validation-for="Fecha" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Lugar" class="form-label"></label>
    <input asp-for="Lugar" class="form-control" />
    <span asp-validation-for="Lugar" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Aforo" class="form-label"></label>
    <input asp-for="Aforo" type="number" class="form-control" />
    <span asp-validation-for="Aforo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Precio" class="form-label"></label>
    <input asp-for="Precio" type="number" step="0.01"
           min="0" class="form-control" />
    <span asp-validation-for="Precio" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Modalidad" class="form-label"></label>
    <select asp-for="Modalidad" class="form-select">
        <option value="">Selecciona una modalidad</option>
        <option value="Presencial">Presencial</option>
        <option value="Virtual">Virtual</option>
    </select>
    <span asp-validation-for="Modalidad" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoriaId" class="form-label">Categoría</label>
    <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId"
            class="form-select">
        <option value="">Selecciona una categoría</option>
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>