@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Registrar Evento";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="mb-3">
            <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-2">
                <i class="bi bi-arrow-left"></i> Volver a la lista de eventos
            </a>
            <h2 class="fw-bold mb-1">Registrar Nuevo Evento</h2>
            <p class="text-muted small">Completa los campos requeridos para publicar el evento en el sistema.</p>
        </div>

        <div class="card border-0 shadow-sm p-4 p-md-5 bg-white">
            <form asp-action="Create" method="post">
                <partial name="_Formulario" model="Model" />

                <div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 shadow-sm">
                        <i class="bi bi-save2-fill"></i>
                        <span>Guardar Evento</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-4">
                        <i class="bi bi-x-circle"></i>
                        <span>Cancelar</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
